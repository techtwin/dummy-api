{
  "name": "dummy-api",
  "description": "Dummy project to practice api and nodejs",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/techtwin/dummy-api.git"
  },
  "engines": {
    "node": "^22"
  },
  "license": "ISC",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "spec:split": "redocly split openapi/specification.yaml --outDir openapi && mv -f 'openapi/openapi.yaml' 'openapi/specification.yaml'",
    "spec:bundle": "redocly bundle openapi/specification.yaml --output openapi/specification.yaml && rm -r openapi/components && rm -r openapi/paths",
    "spec:dist": "redocly bundle",
    "spec:lint": "redocly lint openapi/specification.yaml",
    "spec:build": "redocly build-docs external@latest -o public/index.html"
  },
  "dependencies": {
    "express": "^5.0.1",
    "dd-trace": "^5.22.0"
  },
  "devDependencies": {
    "@redocly/cli": "^1.33.0",
    "@redocly/openapi-core": "^1.28.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "jest-junit": "^12.0.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "reporters": [
      "default", [
        "github-actions", {
          "silent": false
        }
      ],
      "summary"
    ],
    "collectCoverage": true,
    "coverageDirectory": "./test-reports",
    "coverageReporters": [
      "lcov",
      "text"
    ],
    "testEnvironment": "node"
  },
  "jest-junit": {
    "outputDirectory": "./test-reports",
    "outputName": "junit.xml"
  }
}
